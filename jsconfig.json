{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "src/accessibility/clipboard.js",
    "src/accessibility/tabs.js",
    "src/analytics/events.js",
    "src/atlas/atlas-url.js",
    "src/evidence/chart-table.js",
    "src/publication/persian-format.js",
    "src/publication/publication.js",
    "src/routes/route.js"
  ]
}
